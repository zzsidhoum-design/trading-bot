# ===== Core =====
QTRADER_MODE=backtest          # backtest | paper | live
ENABLE_LIVE_TRADING=false      # must ALSO be true for live mode
LOG_LEVEL=INFO

# ===== Database (PostgreSQL) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qtrader
POSTGRES_USER=qtrader
POSTGRES_PASSWORD=qtrader_dev_only

# ===== Cache / Coordination (Redis) =====
REDIS_URL=redis://localhost:6379/0

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me

# ===== Resilience & Sharding (Phase 8) =====
PROVIDER_FAILURE_THRESHOLD=5        # consecutive failures before the circuit breaker opens
PROVIDER_RESET_TIMEOUT_SECONDS=30.0 # how long an open breaker waits before probing
WORKER_SHARDS=1                     # total worker count (universe is sharded across them)
WORKER_SHARD_ID=0                   # this worker's slice; must be in [0, WORKER_SHARDS)

# ===== Trading Session (exchange open hours) =====
# The pipeline (backfill/scan/execute) only runs while the market is open.
# MARKET_TIMEZONE=America/New_York
# MARKET_OPEN=09:30
# MARKET_CLOSE=16:00
# MARKET_HOLIDAYS=            # extra closed dates, comma-separated YYYY-MM-DD
# MARKET_ALWAYS_OPEN=false    # true disables the calendar (backtests/CI)

# ===== Market Data (Phase 2) =====
# YAHOO_ENABLED=true
# POLYGON_API_KEY=

# ===== Broker (Phase 5) =====
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true

# ===== LLM (Phase 3) =====
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ===== Phase 6 live verification =====
# GATE_STRATEGY=value_factor      # strategy whose track record gates paper/live execution
# GATE_OOS_STRATEGY=value_factor  # walk-forward OOS summary consulted first (default: walk-forward)
# GATE_MIN_TRADES=30
# GATE_MIN_PROFIT_FACTOR=1.20
# GATE_MIN_SHARPE=1.00
# GATE_MAX_DRAWDOWN=0.25
# GATE_MIN_TOTAL_RETURN=0.0
