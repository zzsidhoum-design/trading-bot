# ===== Core =====
QTRADER_MODE=backtest          # backtest | paper | live
ENABLE_LIVE_TRADING=false      # must ALSO be true for live mode
LOG_LEVEL=INFO

# ===== Database (PostgreSQL) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qtrader
POSTGRES_USER=qtrader
POSTGRES_PASSWORD=qtrader_dev_only

# ===== Cache / Coordination (Redis) =====
REDIS_URL=redis://localhost:6379/0

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me

