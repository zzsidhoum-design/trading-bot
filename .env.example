# ===== Core =====
QTRADER_MODE=backtest          # backtest | paper | live
ENABLE_LIVE_TRADING=false      # must ALSO be true for live mode
LOG_LEVEL=INFO

# ===== Database (PostgreSQL) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qtrader
POSTGRES_USER=qtrader
POSTGRES_PASSWORD=qtrader_dev_only

# ===== Cache / Coordination (Redis) =====
REDIS_URL=redis://localhost:6379/0

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me

# ===== Resilience & Sharding (Phase 8) =====
PROVIDER_FAILURE_THRESHOLD=5        # consecutive failures before the circuit breaker opens
PROVIDER_RESET_TIMEOUT_SECONDS=30.0 # how long an open breaker waits before probing
WORKER_SHARDS=1                     # total worker count (universe is sharded across them)
WORKER_SHARD_ID=0                   # this worker's slice; must be in [0, WORKER_SHARDS)

# ===== Market Data (Phase 2) =====
# YAHOO_ENABLED=true
# POLYGON_API_KEY=

# ===== Broker (Phase 5) =====
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true

